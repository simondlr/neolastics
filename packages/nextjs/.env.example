# Required: Get this from https://thegraph.com/studio
NEXT_PUBLIC_GRAPH_API_KEY=your_graph_api_key_here

# Recommended: Get this from https://cloud.walletconnect.com
# Enables mobile wallet QR connections, and is the mainnet RPC (WalletConnect's RPC, keyed by this project ID)
# used to confirm transactions. Without it, the app falls back to a public RPC.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_project_id_here
